# Telegram Bot credentials
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# Секретный токен для защиты эндпоинта /api/check?token=...
SCHEDULER_TOKEN=my-secret-cron-token

# Фильтр мест:
# lower_non_side - только нижние не боковые (места 1-35 нечётные) [по умолчанию]
# lower          - любые нижние полки (включая боковые)
# all            - любые места
SEAT_FILTER=lower_non_side

# Минимальное количество свободных мест для отправки уведомления
MIN_AVAILABLE=1

# Максимальное количество вагонов в одном сообщении
MAX_RESULTS=5

# Отправлять ли сообщение в Telegram, если подходящих мест нет (true/false)
ALWAYS_NOTIFY=false

# URL запроса наличия мест на pass.rw.by (скопированный из DevTools Network -> car_places)
TARGET_URL=https://pass.rw.by/ru/ajax/route/car_places/?from=2100001&to=2100180&date=2026-10-10&train_number=657%D0%91&car_type=3&apply_modificator=&from_time=1776801420&_=1776706027315

# Актуальные Cookie / заголовки из браузера (если pass.rw.by возвращает 401/403 или верификацию)
# REQUEST_HEADERS_JSON={"Cookie":"session=...; hg-client-security=..."}
